# Classic fallback configuration. Use this file as sdkconfig.defaults when
# building the original Bluedroid HIDP firmware.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_BLE_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=n
CONFIG_BT_HID_ENABLED=y
CONFIG_BT_HID_DEVICE_ENABLED=y
CONFIG_BT_SDP_COMMON_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_SWITCH_CONTROLLER_BLE_HID=n
CONFIG_SWITCH_CONTROLLER_BTSTACK=n
