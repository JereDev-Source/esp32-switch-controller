CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_BLE_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=n
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BTSTACK_INTERNAL_BT=y
CONFIG_BTSTACK_EXTERNAL_UART_BT=n
CONFIG_BTSTACK_AUDIO=n
CONFIG_BTSTACK_HCI_DUMP_STDOUT=n
CONFIG_SWITCH_CONTROLLER_BLE_HID=n
CONFIG_SWITCH_CONTROLLER_BTSTACK=y
CONFIG_BT_SMP_CRYPTO_STACK_TINYCRYPT=y
CONFIG_LOG_DEFAULT_LEVEL_DEBUG=y
CONFIG_FREERTOS_HZ=1000
